PORT=4000
# TURN relay for broadcast and voice behind carrier NAT (comma-separate several URLs)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Or a full ICE server list as JSON, which overrides the three above
# ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
# Only when the client is served from a different origin
# CORS_ORIGIN=https://example.com
# LOTY_DEBUG=1
